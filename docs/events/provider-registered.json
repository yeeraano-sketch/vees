{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderRegistered",
  "type": "object",
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "ProviderRegistered" },
    "entityType": { "const": "Provider" },
    "entityId": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "producer": { "type": "string" },
    "payload": {
      "type": "object",
      "properties": {
        "providerId": { "type": "string" }
      },
      "required": ["providerId"]
    }
  },
  "required": ["eventId", "eventType", "entityType", "entityId", "version", "occurredAt", "producer", "payload"]
}
